<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock.stock_move_line_action" model="ir.actions.act_window">
            <field name="name">Food Moves</field>
            <field name="res_model">stock.move.line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,kanban,pivot,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    There are no food moves yet
                </p><p>
                    This menu gives you the full traceability of inventory operations on food items.
                </p>
            </field>
        </record>

        <record id="product.product_category_action_form" model="ir.actions.act_window">
            <field name="name">Food Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.category</field>
        </record>

        <menuitem id="stock.menu_product_in_config_stock" name="Food" parent="stock.menu_stock_config_settings" sequence="4"/>
        <menuitem action="product.product_category_action_form" id="stock.menu_product_category_config_stock"
                  name="Food Categories" parent="stock.menu_product_in_config_stock" sequence="2"/>
        <menuitem action="stock.stock_move_line_action"
                  id="stock.stock_move_line_menu"
                  parent="stock.menu_warehouse_report" name="Food Moves" sequence="150"/>
    </data>
</odoo>