<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem
                id="point_of_sale.menu_point_root"
                name="Restaurant"
                web_icon="restaurant_management,static/description/icon.png"
                sequence="5"/>

        <menuitem id="point_of_sale.menu_point_of_sale_customer"
                  name="Guests"
                  parent="point_of_sale.menu_point_of_sale"
                  action="account.res_partner_action_customer"
                  sequence="100"/>

        <menuitem id="point_of_sale.menu_products_pos_category"
                  action="point_of_sale.product_pos_category_action"
                  parent="point_of_sale.pos_menu_products_configuration"
                  name="Menu Categories"
                  sequence="1"/>

        <menuitem id="point_of_sale.pos_menu_products_configuration"
                  name="Menu Items"
                  parent="point_of_sale.menu_point_config_product"
                  sequence="11"/>

        <record id="account.res_partner_action_customer" model="ir.actions.act_window">
            <field name="name">Guests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_customer': 1, 'res_partner_search_mode': 'customer',
                'default_is_company': True, 'default_customer_rank': 1}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new guest
                </p>
                <p>
                    Manage restaurant guests and customer information.
                </p>
            </field>
        </record>

        <record id="point_of_sale.product_pos_category_action" model="ir.actions.act_window">
            <field name="name">Menu Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pos.category</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define a new menu category
                </p>
                <p>
                    Categories are used to browse your menu through the
                    touchscreen POS interface.
                </p>
            </field>
        </record>

        <menuitem id="point_of_sale.pos_config_menu_catalog" groups="restaurant_management.make_invisible_group"/>
        <menuitem id="point_of_sale.menu_pos_products" groups="restaurant_management.make_invisible_group"/>
    </data>
</odoo>