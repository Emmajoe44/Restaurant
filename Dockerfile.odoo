FROM odoo:16.0

USER root

# Install system dependencies (node, npm, wkhtmltopdf, build tools)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg2 \
    build-essential \
    git \
    wget \
    xz-utils \
    libxrender1 \
    libxext6 \
    libfontconfig1 \
    fontconfig \
    libfreetype6 \
    wkhtmltopdf \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g yarn less less-plugin-clean-css rtlcss \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch back to odoo user
USER odoo

WORKDIR /mnt/extra-addons
