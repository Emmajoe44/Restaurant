<odoo>
    <data>
        <!-- Inherit Product Template Form View to Modify it -->
        <record id="inherit_product_template_form" model="ir.ui.view">
            <field name="name">Product Template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//page[3]" position="after">
                    <page name="product_notifications" string="Product Notifications">
                        <group>
                            <group string="Responsible">
                                <field name="responsible_user"/>
                            </group>
                            <group string="Expiration Date">
                                <field name="expiration_date_notification"/>
                                <field name="notification_date"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>