<?xml version="1.0"?>
<odoo>
	<data>
		<record id="pos_payment_view_form" model="ir.ui.view">
			<field name="name">pos.payment.form.view</field>
			<field name="model">pos.order</field>
			<field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='payment_ids']/tree/field[@name='amount']" position="after">
					<field name = "amount_currency" groups="base.group_multi_currency"/>
					<field name = "currency" groups="base.group_multi_currency"/>
				</xpath>
			</field>
		</record>

		<record id="pos_payment_methods_view_form" model="ir.ui.view">
            <field name="name">Payment Method</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"></field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='use_payment_terminal']" position="after">
                    <field name="journal_id"/>
					<field name="separate_invoice"/>
					 <field name="generate_revenue"/>
					 <field name="stock_movement"/>
                </xpath>
            </field>
        </record>
	</data>
</odoo>