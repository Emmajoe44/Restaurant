<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <report
                id="product_details_report"
                model="product.details.wizard"
                string="Product Details"
                name="custom_product.product_details_report_view"
                report_type="qweb-pdf"
                menu="False"
        />


        <template id="product_details_report_view">
            <t t-call="web.html_container">
                <div class="header"
                     style="font-family:KacstNaskh,Verdana,Arial,sans-serif;border-bottom: 1px solid black;padding-bottom:10px">
                    <div class="col-3">
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                    </div>
                </div>

                <div class="article mt0 o_report_layout_standard">
                    <h5 class="text-center">
                        <strong>Product Details</strong>
                    </h5>
                    <span class="text-right" >
                        <strong>Total Amount:</strong>
                        <t t-esc="total_amount"/>
                    </span>
                    <br/>
                    <br/>
                    <ol type="1" style="text-align:center;list-style-position:inside;list-style-type: decimal">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <th class="text-left" style="width: 15%">#</th>
                                <th class="text-left" style="width: 15%">Product</th>
                                <th class="text-left" style="width: 18%">Category</th>
                                <th class="text-left" style="width: 25%">Price</th>
                                <th class="text-left" style="width: 25%">Quantity</th>
                                <th class="text-left" style="width: 20%">Amount</th>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="doc">

                                    <tr>
                                        <td class="text-left">
                                            <li></li>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="doc['product_name']"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="doc['category_id']"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="doc['list_price']"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="doc['qty_available']"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="doc['amount']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </ol>
                </div>
                <div class="footer">
                    <div class="row text-center" style="border-top: 1px solid black;">
                        <div class="col col-3 offset-9 text-right">
                            <ul class="list-inline mt-2">
                                <li class="list-inline-item">Page:</li>
                                <li class="list-inline-item">
                                    <span class="page"/>
                                </li>
                                <li class="list-inline-item">/</li>
                                <li class="list-inline-item">
                                    <span class="topage"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>