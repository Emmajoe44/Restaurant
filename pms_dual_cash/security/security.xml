<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="module_category_pms_restaurant">
            <field name="name">Restaurant</field>
            <field name="description">Restaurant POS and accounting access roles</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_pms_cashier" model="res.groups">
            <field name="name">Cashier</field>
            <field name="category_id" ref="module_category_pms_restaurant"/>
            <field name="comment">POS sales with SSP/USD cash. Can load demo products only.</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('base.group_multi_currency')),
                (4, ref('point_of_sale.group_pos_user')),
            ]"/>
        </record>

        <record id="group_pms_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="category_id" ref="module_category_pms_restaurant"/>
            <field name="comment">Accounting, reports, and restaurant demo reset.</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('base.group_multi_currency')),
                (4, ref('account.group_account_user')),
                (4, ref('point_of_sale.group_pos_user')),
            ]"/>
        </record>

        <record id="group_pms_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_pms_restaurant"/>
            <field name="comment">Full restaurant accounting, POS configuration, and demo reset.</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('base.group_multi_currency')),
                (4, ref('account.group_account_manager')),
                (4, ref('point_of_sale.group_pos_manager')),
            ]"/>
        </record>

    </data>
</odoo>
