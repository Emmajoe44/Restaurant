<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--    Sales Details Wizard Form    -->
        <record id="sales_details_wizard_view_form" model="ir.ui.view">
            <field name="name">Sale Details</field>
            <field name="model">sales.details.wizard</field>
            <field name="arch" type="xml">
                <form string="sales_details_wizard_form">
                    <group>
                        <group>
                            <field name="from_date"/>
                        </group>
                        <group>
                            <field name="to_date"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_sales_details" string="Print" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <!--    Sales Details Wizard Action    -->
        <record id="sales_details_wizard_action" model="ir.actions.act_window">
            <field name="name">Sales Details Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sales.details.wizard</field>
            <field name="target">new</field>
            <field name="view_mode">form</field>
        </record>
        <!--    Sales Details Wizard Menu    -->
        <menuitem id="sales_details_report_menu" name="Sales Details" parent="sale.menu_sale_report" action="sales_details_wizard_action"
                  sequence="2"/>
    </data>
</odoo>